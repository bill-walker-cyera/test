PENDO_INTEGRATION_KEY=your_pendo_integration_key
PENDO_BASE_URL=https://app.pendo.io
PENDO_NPS_API_URL=https://app.pendo.io/api/v1/poll/12345/response
PENDO_NPS_METHOD=GET
PENDO_NPS_RESULTS_PATH=responses
PENDO_EXTERNAL_ID_PATH=id

SFDC_LOGIN_URL=https://login.salesforce.com
SFDC_CLIENT_ID=your_salesforce_client_id
SFDC_CLIENT_SECRET=your_salesforce_client_secret
SFDC_USERNAME=your_salesforce_username
SFDC_PASSWORD=your_salesforce_password
SFDC_SECURITY_TOKEN=your_salesforce_security_token
SFDC_API_VERSION=60.0
SFDC_OBJECT=NPS_Response__c
SFDC_EXTERNAL_ID_FIELD=Pendo_Response_Id__c
SFDC_FIELD_MAP={"Pendo_Response_Id__c":"id","Response_Date__c":["createdAt","createdAtISO"],"Tenant_ID__c":["visitor.accountId","accountId"],"User_ID__c":["visitor.id","visitorId"],"Score__c":["score","rating"],"Comments__c":["comment","comments"]}
SFDC_STATIC_FIELDS={"Source__c":"Pendo"}
SFDC_CONCURRENCY=5
